# ==========================================
# SENTIMENT-APLHA Configuration
# ==========================================
PROJECT_NAME="SENTIMENT-APLHA"
ENVIRONMENT="development"
PORT=8000

# Database (Default: SQLite, production can switch to PostgreSQL)
DATABASE_URL="sqlite:///./sentiment_alpha.db"

# FinBERT & NLP Settings
FINBERT_MODEL_NAME="ProsusAI/finbert"
FINBERT_DEVICE="cpu"
FINBERT_OFFLINE=false
LIGHTWEIGHT_MODE=false

# Google Gemini API Settings (for Intelligent Financial Knowledge Assistant)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Machine Learning & Walk-Forward
DEFAULT_HORIZONS="[1, 5, 10]"
WALK_FORWARD_SPLITS=5
EMBARGO_PERIOD_DAYS=5

# Reddit PRAW Configuration (Optional: defaults to curated financial feeds if credentials omitted)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="SentimentAlpha/1.0"

# External Market Data & News
NEWS_REQUEST_TIMEOUT=15
MAX_ARTICLES_PER_FEED=50
