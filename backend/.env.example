# SentimentAlpha Environment Configuration
ENVIRONMENT=development
DATABASE_URL=sqlite:///./sentiment_alpha.db

# FinBERT Local Settings
FINBERT_MODEL_NAME=ProsusAI/finbert
FINBERT_DEVICE=cpu
FINBERT_BATCH_SIZE=16
FINBERT_MAX_LENGTH=256
FINBERT_OFFLINE=False
LIGHTWEIGHT_MODE=False

# Ingestion Settings
NEWS_REQUEST_TIMEOUT=15
MAX_ARTICLES_PER_FEED=50
